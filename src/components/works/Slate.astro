---
/**
 * 作品章「片单」：主推之外的作品，一部一张 2:3 的海报。
 * 海报墙未公开（SLATE_PUBLIC = false）时，有了产品页的作品露出海报：画面是它的 App 图标（KeyArt 的 poster），
 * 整张可点，点进去画面放大成产品页首屏；其余只是空白海报位，不露片名与颜色。作品多了自动换行。
 */
import Cta from '@/components/Cta.astro';
import KeyArt from '@/components/KeyArt.astro';
import StatusChip from '@/components/StatusChip.astro';
import { productPath, slateProducts, themeVars } from '@/data/products';
import { href, strings, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang];
const count = slateProducts.length;
const pad = (n: number) => String(n).padStart(2, '0');
// 中文在逗号后断行，避免“正 / 在拍摄”这种断法
const headingLines = t.slate.count(count).split(/(?<=，)/);
---

{
  count > 0 && (
    <section class="slate" id="slate" data-scene="03" data-scene-label={t.scenes.slate}>
      <div class="intro">
        <h2 class="display heading" data-reveal-lines>
          {headingLines.map((line, i) => (
            <span class="mask-line">
              <span style={`--i:${i}`}>{line}</span>
            </span>
          ))}
        </h2>
        <p class="meta" data-reveal style="--i:2">
          {t.slate.note}
        </p>
      </div>

      <ol class="slots">
        {slateProducts.map((product, i) => (
          <li class="slot" data-reveal style={`--i:${i}`}>
            {/* 有产品页的露出海报，罩上产品自己的世界：底色、墨色和产品页一样，放大成首屏时才接得上 */}
            {product.page ? (
              <a
                class="poster poster--open"
                href={href(lang, productPath(product))}
                data-theme={product.page.theme ? 'app' : undefined}
                style={`--accent:${product.accent};${product.page.theme ? themeVars(product.page.theme) : ''}`}
              >
                <KeyArt product={product} variant="poster" />
                <span class="meta no">No.{pad(i + 2)}</span>
                <span class="credit">
                  <span class="credit__titles">
                    <StatusChip status={product.status} lang={lang} />
                    <span class="display name">{product.name[lang]}</span>
                  </span>
                  <Cta class="go" />
                </span>
              </a>
            ) : (
              <div class="poster">
                <span class="meta no">No.{pad(i + 2)}</span>
                <span class="untitled display">{t.slate.untitled}</span>
                <span class="meta status">{t.slate.slot}</span>
              </div>
            )}
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .slate {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gutter);
    row-gap: 48px;
    margin: 0 var(--gutter);
    padding: clamp(80px, 14svh, 160px) 0 clamp(80px, 12svh, 140px);
    border-top: 1px solid var(--line);
  }

  .intro {
    grid-column: 1 / span 4;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .heading {
    font-size: var(--fs-h2);
  }

  .slots {
    grid-column: 5 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
    gap: clamp(14px, 1.6vw, 24px);
  }

  .poster {
    position: relative;
    aspect-ratio: 2 / 3;
    border: 1px solid var(--line);
    background:
      linear-gradient(180deg, rgb(236 232 225 / 0.025), transparent 40%),
      var(--bg-raise);
    overflow: hidden;
    transition: border-color 1s var(--ease-film);
  }

  /* 空白海报位：悬停时一道很淡的光扫过，像放映机在等片 */
  .poster:not(.poster--open)::after {
    content: '';
    position: absolute;
    inset: -20% -60%;
    background: linear-gradient(105deg, transparent 40%, rgb(236 232 225 / 0.05) 50%, transparent 60%);
    transform: translateX(-60%);
    transition: transform 1.6s var(--ease-film);
  }

  .slot:hover .poster {
    border-color: var(--ink-4);
  }

  .slot:hover .poster:not(.poster--open)::after {
    transform: translateX(60%);
  }

  /* 露出的海报：画面铺满，编号、片名压在上面 */
  .poster--open {
    display: block;
    color: var(--ink);
  }

  .poster--open > :global(.keyart) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
  }

  .credit {
    position: absolute;
    left: 18px;
    right: 14px;
    bottom: 16px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }

  .credit__titles {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .name {
    font-size: clamp(1.25rem, 1.6vw, 1.5rem);
    line-height: 1.15;
  }

  :lang(zh) .name {
    font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
    font-weight: 500;
  }

  .credit > :global(.go) {
    --cta-size: 38px;
    flex: none;
    transition: transform 0.9s var(--ease-film);
  }

  .poster--open:hover > .credit > :global(.go) {
    transform: translateX(4px);
  }

  .no {
    position: absolute;
    top: 18px;
    left: 18px;
  }

  .status {
    position: absolute;
    left: 18px;
    bottom: 18px;
  }

  .untitled {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: clamp(1.25rem, 1.6vw, 1.5rem);
    font-style: italic;
    color: var(--ink-4);
  }

  :lang(zh) .untitled {
    font-style: normal;
    font-size: 1rem;
    letter-spacing: 0.2em;
  }

  @media (max-width: 900px) {
    .intro,
    .slots {
      grid-column: 1 / -1;
    }
  }

  /* 手机：横向滑动，和未来的海报墙一致 */
  @media (max-width: 640px) {
    .slate {
      margin: 0;
      padding-left: var(--gutter);
      padding-right: 0;
      border-top: 0;
    }

    .intro {
      padding-right: var(--gutter);
    }

    .slots {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-right: var(--gutter);
    }

    .slots::-webkit-scrollbar {
      display: none;
    }

    .slot {
      flex: 0 0 58vw;
      scroll-snap-align: start;
    }
  }
</style>
