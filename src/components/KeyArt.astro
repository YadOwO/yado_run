---
/**
 * 产品主视觉：暗场 + 产品色的地灯 + 品牌标志。
 * 首页目录里是一帧小缩略（thumb），作品章是一块 2.39:1 的画幅（panel），产品页是整屏（full）；
 * 三处共用同一个 view-transition-name，一路点进去，画面会从缩略放大到画幅、再放大成产品页首屏。
 * 产品有自己的世界（page.theme）时，整屏那一帧换成 App 深色外观的图标：石墨色的底从左上亮到右下，
 * 标志本来就是 App 深色外观的配色。于是点进来的那一下，暗场里的画幅放大成 App 图标，像打开了这个 App。
 */
import type { Product } from '@/data/products';
import { productMarks } from './productMarks';

interface Props {
  product: Product;
  variant: 'thumb' | 'panel' | 'full';
}

const { product, variant } = Astro.props;
const app = variant === 'full' && !!product.page?.theme;

const mark = productMarks[product.slug];
/** 同一页可能出现两次同一个标志（首页正片和目录缩略），遮罩 id 带上用途才不会串 */
const maskId = `wipe-${product.slug}-${variant}`;
---

<div
  class:list={['keyart', `keyart--${variant}`, { 'keyart--app': app }]}
  style={`view-transition-name: keyart-${product.slug}; view-transition-class: keyart; --accent: ${product.accent}`}
  data-inview
>
  <div class="light" aria-hidden="true"></div>
  <div class="floor" aria-hidden="true"></div>

  <div class="mark">
    {
      mark ? (
        <svg viewBox={mark.viewBox} fill="none" role="img" aria-label={product.codename}>
          <defs>
            <mask id={maskId} maskUnits="userSpaceOnUse">
              <rect class="wipe" x={mark.wipe[0]} y={mark.wipe[1]} width={mark.wipe[2]} height={mark.wipe[3]} fill="#fff" />
            </mask>
          </defs>
          {mark.paths.map((p, i) => (
            <path d={p.d} fill={p.fill} mask={i === mark.paths.length - 1 ? `url(#${maskId})` : undefined} />
          ))}
        </svg>
      ) : (
        <span class="mark__fallback display">{product.codename}</span>
      )
    }
  </div>

  <span class="crop crop--tl" aria-hidden="true"></span>
  <span class="crop crop--tr" aria-hidden="true"></span>
  <span class="crop crop--bl" aria-hidden="true"></span>
  <span class="crop crop--br" aria-hidden="true"></span>
  <span class="label label--tl meta case" aria-hidden="true">{product.codename} — {product.year}</span>
  <span class="label label--br meta case" aria-hidden="true">{product.platform}</span>
</div>

<style>
  .keyart {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: #0d0c0c;
    contain: paint;
  }

  .keyart--panel,
  .keyart--thumb {
    aspect-ratio: 2.39 / 1;
  }

  .keyart--full {
    position: absolute;
    inset: 0;
  }

  @media (orientation: portrait) {
    .keyart--panel {
      aspect-ratio: 4 / 5;
    }
  }

  /* 地灯：产品色从画面底部打上来；顶部一层很淡的冷光补光 */
  .light {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 58% 62% at 50% 108%, color-mix(in oklab, var(--accent) 46%, transparent) 0%, transparent 72%),
      radial-gradient(ellipse 44% 38% at 50% -4%, rgb(236 232 225 / 0.07), transparent 70%);
    animation: breathe 7s ease-in-out infinite alternate;
  }

  @keyframes breathe {
    from {
      opacity: 0.78;
    }
    to {
      opacity: 1;
    }
  }

  /* 舞台地面的一圈投影 */
  .floor {
    position: absolute;
    left: 50%;
    bottom: 14%;
    width: 34%;
    height: 7%;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.55), transparent);
    filter: blur(6px);
  }

  .mark {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .mark svg {
    height: 52%;
    width: auto;
    filter: drop-shadow(0 28px 48px rgb(0 0 0 / 0.55));
    transition: transform 1.4s var(--ease-film);
  }

  .keyart--full .mark svg {
    height: min(40svh, 58vw);
    translate: 0 -6svh;
  }

  /* ---------- App 图标（深色外观） ---------- */
  /* 石墨色从左上的亮面过渡到右下的底色，和 App 图标的底色渐变一样；右下正好接上页面底色 */
  .keyart--app {
    background: linear-gradient(150deg, color-mix(in srgb, var(--bg-raise) 92%, var(--ink)) 0%, var(--bg-raise) 38%, var(--bg) 78%);
  }

  /* 不用舞台地灯，只留左上一层很淡的反光 */
  .keyart--app .light {
    background: radial-gradient(ellipse 60% 52% at 26% 0%, rgb(255 255 255 / 0.05), transparent 72%);
  }

  .mark__fallback {
    font-size: var(--fs-title);
    color: var(--ink);
  }

  /* 对勾的书写：遮罩矩形从左往右展开 */
  .wipe {
    transform-box: fill-box;
    transform-origin: left center;
  }

  :global(.js) .wipe {
    transform: scaleX(0);
  }

  :global(.js) .keyart.is-in .wipe {
    transform: scaleX(1);
    transition: transform 1s var(--ease-pen) 0.55s;
  }

  /* 取景框的四角裁切线 */
  .crop {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--ink-4);
    border-style: solid;
    border-width: 0;
  }

  .crop--tl { top: 18px; left: 18px; border-top-width: 1px; border-left-width: 1px; }
  .crop--tr { top: 18px; right: 18px; border-top-width: 1px; border-right-width: 1px; }
  .crop--bl { bottom: 18px; left: 18px; border-bottom-width: 1px; border-left-width: 1px; }
  .crop--br { bottom: 18px; right: 18px; border-bottom-width: 1px; border-right-width: 1px; }

  .label {
    position: absolute;
    color: var(--ink-3);
  }

  .label--tl { top: 40px; left: 40px; }
  .label--br { bottom: 40px; right: 40px; }

  .keyart--full .crop,
  .keyart--full .label,
  .keyart--thumb .label {
    display: none;
  }

  .keyart--thumb .crop {
    width: 10px;
    height: 10px;
  }

  .keyart--thumb .crop--tl { top: 12px; left: 12px; }
  .keyart--thumb .crop--tr { top: 12px; right: 12px; }
  .keyart--thumb .crop--bl { bottom: 12px; left: 12px; }
  .keyart--thumb .crop--br { bottom: 12px; right: 12px; }

  /* 滚动推镜：支持滚动时间线的浏览器里，标志随滚动缓慢放大 */
  @supports (animation-timeline: view()) {
    /*
     * 时间线挂在画幅本身：.keyart 是 overflow:hidden，自己就是滚动容器，
     * 里面的 .mark 用 view() 会去看这个不会滚的盒子，进度永远卡在一半。
     * 范围用默认的 cover（进画到出画）。
     */
    .keyart--panel {
      view-timeline: --keyart block;
    }

    .keyart--panel .mark {
      animation: push-in linear both;
    }

    /* animation-timeline 必须单独一条规则：CSS 压缩会把它并进 animation 简写，Chrome 不认，整条丢掉 */
    .keyart--panel > .mark {
      animation-timeline: --keyart;
    }

    @keyframes push-in {
      from {
        transform: scale(0.94);
      }
      to {
        transform: scale(1.08);
      }
    }
  }

  @media (hover: hover) {
    :global(a:hover) > .keyart .mark svg {
      transform: translateY(-8px);
    }
  }

  @media (max-width: 640px) {
    .label--tl { top: 32px; left: 32px; }
    .label--br { bottom: 32px; right: 32px; }
  }
</style>
