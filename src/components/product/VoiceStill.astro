---
/**
 * 剧照：App 里的一张语音卡片，用页面的底色和墨色（产品页有 theme 时就是 App 深色外观），把“一句话记两笔”演一遍：
 * 听到的话像墨水一样写出来 → 对勾写出 → 两笔账依次落下，每笔前面的色块上写出一个红对勾（App 里“刚记下”的样子）。
 * 卡片边框、行间细线、色块都是 App 里的手绘笔迹。滚动到眼前时只演一次。
 */
import type { Still } from '@/data/products';
import type { Lang } from '@/i18n';
import InkBox from '@/components/ink/InkBox.astro';
import InkRule from '@/components/ink/InkRule.astro';
import { blobPath, tick } from '@/components/ink/handDrawn';

interface Props {
  still: Still;
  lang: Lang;
}

const { still, lang } = Astro.props;
---

<figure class="still" data-inview>
  <div class="stage">
    <div class="paper">
      <InkBox width={360} height={300} radius={26} seed="voice-still" />

      <p class="heard">
        <span class="mic" aria-hidden="true"></span>
        <span class="words">{still.heard[lang]}</span>
      </p>

      <p class="done">
        <svg class="tick" viewBox={tick.viewBox} aria-hidden="true"><path d={tick.d}></path></svg>
        {still.done[lang]}
      </p>

      <InkRule hand heavy seed="voice-still-heading" class="heading-rule" />

      <ul class="rows">
        {
          still.rows.map((r, i) => (
            <li style={`--r:${i}`}>
              <span class="icon" aria-hidden="true">
                <svg class="icon__blob" viewBox="0 0 38 38">
                  <path d={blobPath(38, 38, `voice-still-row-${i}`)} />
                </svg>
                <svg class="icon__tick" viewBox={tick.viewBox}>
                  <path d={tick.d} />
                </svg>
              </span>
              <span class="text">
                <span class="label">{r.label[lang]}</span>
                <span class="cat">{r.category[lang]}</span>
              </span>
              <span class="amt">{r.amount}</span>
              {i < still.rows.length - 1 && <InkRule hand seed={`voice-still-rule-${i}`} class="row-rule" />}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <figcaption class="meta">{still.caption[lang]}</figcaption>
</figure>

<style>
  .still {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  /* 地灯打在卡片下面 */
  .stage {
    position: relative;
    width: 100%;
    display: grid;
    place-items: center;
    padding: clamp(56px, 10svh, 112px) 0;
    background: radial-gradient(ellipse 40% 60% at 50% 100%, color-mix(in oklab, var(--accent) 22%, transparent), transparent 70%);
  }

  /* 卡片：App 的 PaperSurface，边框是手绘方框（InkBox），行间是手绘细线 */
  .paper {
    position: relative;
    width: min(360px, 86vw);
    padding: 28px 26px 14px;
    border-radius: 26px;
    background: var(--bg-raise);
    color: var(--ink);
    box-shadow: 0 40px 80px -20px rgb(0 0 0 / 0.7);
    transform: rotate(-1.2deg);
    font-family: var(--font-sans);
  }

  .heard {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.3;
  }

  :global([data-theme='app']) .heard {
    font-size: 1.3125rem;
  }

  :lang(zh) .heard {
    font-size: 1.25rem;
    font-weight: 500;
  }

  .mic {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* 墨水书写：从左往右露出 */
  .words {
    display: inline-block;
  }

  :global(.js) .words {
    clip-path: inset(0 100% 0 0);
  }

  :global(.js) .is-in .words {
    clip-path: inset(0 0 0 0);
    transition: clip-path 1.2s var(--ease-pen) 0.3s;
  }

  .done {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  /* App 图标上那一笔对勾，用强调色写出来 */
  .tick {
    width: 22px;
    height: auto;
    fill: var(--accent);
  }

  :global(.js) .done {
    opacity: 0;
  }

  :global(.js) .is-in .done {
    opacity: 1;
    transition: opacity 0.6s ease 1.5s;
  }

  :global(.js) .tick,
  :global(.js) .icon__tick {
    clip-path: inset(0 100% 0 0);
  }

  :global(.js) .is-in .tick {
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.6s var(--ease-pen) 1.6s;
  }

  /* 对勾写完之后再落这道重线 */
  .paper > :global(.heading-rule) {
    --i: 14;
    margin-top: 10px;
  }

  .rows li {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 12px 2px;
  }

  .rows li > :global(.row-rule) {
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: -2px;
  }

  :global(.js) .rows li {
    opacity: 0;
    transform: translateY(10px);
  }

  :global(.js) .is-in .rows li {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s var(--ease-film),
      transform 0.8s var(--ease-film);
    transition-delay: calc(1.9s + var(--r) * 0.18s);
  }

  /* 图标位：随手涂出的色块，上面写出一个“刚记下”的红对勾 */
  .icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
  }

  .icon > * {
    grid-area: 1 / 1;
  }

  .icon__blob {
    width: 100%;
    height: 100%;
    fill: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .icon__tick {
    width: 22px;
    height: auto;
    fill: var(--accent);
  }

  :global(.js) .is-in .icon__tick {
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.5s var(--ease-pen) calc(2.3s + var(--r) * 0.18s);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .label {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .cat {
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .amt {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
  }
</style>
