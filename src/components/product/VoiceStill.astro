---
/**
 * 剧照：暗场里的一张纸。用产品自己的纸色和墨色，把“一句话记两笔”演一遍：
 * 听到的话像墨水一样写出来 → 对勾 → 两笔账依次落下。滚动到眼前时只演一次。
 */
import type { Still } from '@/data/products';
import type { Lang } from '@/i18n';

interface Props {
  still: Still;
  lang: Lang;
}

const { still, lang } = Astro.props;
---

<figure class="still" style={`--paper:${still.paper};--paper-ink:${still.ink}`} data-inview>
  <div class="stage">
    <div class="paper">
      <p class="heard">
        <span class="mic" aria-hidden="true"></span>
        <span class="words">{still.heard[lang]}</span>
      </p>

      <p class="done">
        <svg class="tick" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12.5l4.2 4.2L19 7" pathLength="1"></path>
        </svg>
        {still.done[lang]}
      </p>

      <ul class="rows">
        {
          still.rows.map((r, i) => (
            <li style={`--r:${i}`}>
              <span class="label">{r.label[lang]}</span>
              <span class="cat">{r.category[lang]}</span>
              <span class="amt">{r.amount}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <figcaption class="meta">{still.caption[lang]}</figcaption>
</figure>

<style>
  .still {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  /* 地灯打在纸下面 */
  .stage {
    position: relative;
    width: 100%;
    display: grid;
    place-items: center;
    padding: clamp(56px, 10svh, 112px) 0;
    background: radial-gradient(ellipse 40% 60% at 50% 100%, color-mix(in oklab, var(--accent) 22%, transparent), transparent 70%);
  }

  .paper {
    width: min(360px, 86vw);
    padding: 28px 26px 18px;
    border-radius: 28px;
    background: var(--paper);
    color: var(--paper-ink);
    box-shadow:
      0 40px 80px -20px rgb(0 0 0 / 0.7),
      0 0 0 1px rgb(255 255 255 / 0.04);
    transform: rotate(-1.2deg);
    font-family: var(--font-sans);
  }

  .heard {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.3;
  }

  :lang(zh) .heard {
    font-size: 1.25rem;
    font-weight: 500;
  }

  .mic {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* 墨水书写：从左往右露出 */
  .words {
    display: inline-block;
  }

  :global(.js) .words {
    clip-path: inset(0 100% 0 0);
  }

  :global(.js) .is-in .words {
    clip-path: inset(0 0 0 0);
    transition: clip-path 1.2s var(--ease-pen) 0.3s;
  }

  .done {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-size: 0.8125rem;
    color: color-mix(in oklab, var(--paper-ink) 60%, transparent);
  }

  .tick {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global(.js) .done {
    opacity: 0;
  }

  :global(.js) .is-in .done {
    opacity: 1;
    transition: opacity 0.6s ease 1.5s;
  }

  :global(.js) .tick path {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
  }

  :global(.js) .is-in .tick path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.6s var(--ease-pen) 1.6s;
  }

  .rows {
    margin-top: 12px;
    border-top: 1px solid color-mix(in oklab, var(--paper-ink) 10%, transparent);
  }

  .rows li {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: 14px;
    padding: 14px 2px;
    border-bottom: 1px solid color-mix(in oklab, var(--paper-ink) 8%, transparent);
  }

  .rows li:last-child {
    border-bottom: 0;
  }

  :global(.js) .rows li {
    opacity: 0;
    transform: translateY(10px);
  }

  :global(.js) .is-in .rows li {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s var(--ease-film),
      transform 0.8s var(--ease-film);
    transition-delay: calc(1.9s + var(--r) * 0.18s);
  }

  .label {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .cat {
    font-size: 0.75rem;
    color: color-mix(in oklab, var(--paper-ink) 50%, transparent);
  }

  .amt {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
  }
</style>
