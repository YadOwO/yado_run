---
/**
 * 剧照：芽豆有物首次引导里的三件示例物品，用页面的底色和墨色（产品页有 theme 时就是 App 深色外观），演一遍
 * 「记下几件东西 → 每件算出每天花多少 → 合计还持有的购入总值」：卡片依次落下 → 每天花多少逐个出现 → 合计浮上来。
 * 卡片照 App 的样子画：平整的表面、上亮下暗的细描边、强调色淡淡铺底的图标块、衬线数字。
 * 滚动到眼前时只演一次；传了 scrub 就改成跟着滚动演，往回滚会倒着演。
 */
import type { ItemsStillData, StillItem } from '@/data/products';
import { htmlLang, strings, type Lang } from '@/i18n';

interface Props {
  still: ItemsStillData;
  lang: Lang;
  /** 跟着滚动演：这场戏在滚动时间线上的起止（contain 百分比）；时间线由外面用 --scrub-timeline 指定 */
  scrub?: { from: number; to: number };
  /** 只要卡片：上下留白收紧，不带图注 */
  compact?: boolean;
}

const { still, lang, scrub, compact = false } = Astro.props;
const t = strings[lang].itemsStill;

/** data-scrub 的值（见 global.css）；不跟滚动时不输出这个属性 */
const act = (kind: 'fade' | 'rise') => (scrub ? kind : undefined);

/** 这场戏里的一步：a、b 是戏内 0–1 的进度，换算成时间线上的一段 */
function cue(a: number, b: number) {
  if (!scrub) return undefined;
  const at = (x: number) => `contain ${(scrub.from + (scrub.to - scrub.from) * x).toFixed(1)}%`;
  return `--from:${at(a)};--to:${at(b)}`;
}

const whole = new Intl.NumberFormat(htmlLang[lang], { maximumFractionDigits: 0 });
const cents = new Intl.NumberFormat(htmlLang[lang], { minimumFractionDigits: 2, maximumFractionDigits: 2 });

/** 每天花多少：卖掉的先扣掉售价，再除以持有天数；和 App 的每日成本同一个算法 */
const daily = (item: StillItem) => (item.price - (item.salePrice ?? 0)) / Math.max(item.days, 1);

/** 还持有的（使用中、已退役）购入总值，已售出的不算 */
const heldTotal = still.items.filter((item) => item.status !== 'sold').reduce((sum, item) => sum + item.price, 0);

/** 图标：24 格的线描，描边色随强调色 */
const icons: Record<StillItem['icon'], string> = {
  camera:
    '<path d="M4 8.5A2.5 2.5 0 0 1 6.5 6h1.7l1.3-2h5l1.3 2h1.7A2.5 2.5 0 0 1 20 8.5v8a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5z"/><circle cx="12" cy="12.5" r="3.5"/>',
  headphones:
    '<path d="M4.5 16v-4a7.5 7.5 0 0 1 15 0v4"/><rect x="3.5" y="13.5" width="4" height="6.5" rx="1.6"/><rect x="16.5" y="13.5" width="4" height="6.5" rx="1.6"/>',
  gamepad:
    '<path d="M7.5 7.5h9a4.5 4.5 0 0 1 4.4 3.6l.9 4.5a2.4 2.4 0 0 1-4.2 2l-2.1-2.6H8.5l-2.1 2.6a2.4 2.4 0 0 1-4.2-2l.9-4.5a4.5 4.5 0 0 1 4.4-3.6z"/><path d="M8 10v3.5M6.25 11.75h3.5"/><circle class="fill" cx="16.9" cy="10.9" r="0.9"/><circle class="fill" cx="15.1" cy="12.6" r="0.9"/>',
};
---

<figure class:list={['still', { 'still--compact': compact }]} data-inview>
  <div class="stage">
    <div class="sheet">
      <ul class="items">
        {
          still.items.map((item, i) => (
            <li class="card" data-scrub={act('rise')} style={`--r:${i};${cue(i * 0.14, 0.22 + i * 0.14) ?? ''}`}>
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" set:html={icons[item.icon]} />
              </span>
              <span class="text">
                <span class="name">{item.name[lang]}</span>
                <span class="sub">
                  <i class:list={['dot', `dot--${item.status}`]} aria-hidden="true" />
                  {t.status[item.status]} · {t.days(item.days)}
                </span>
              </span>
              <span class="nums">
                <span class="price">{whole.format(item.price)}</span>
                <span class="daily" data-scrub={act('fade')} style={cue(0.5 + i * 0.08, 0.6 + i * 0.08)}>
                  {cents.format(daily(item))}
                  <span class="unit">{t.perDay}</span>
                </span>
              </span>
            </li>
          ))
        }
      </ul>

      <p class="card total" data-scrub={act('rise')} style={cue(0.78, 0.96)}>
        <span class="eyebrow">{t.total}</span>
        <span class="sum">{whole.format(heldTotal)}</span>
      </p>
    </div>
  </div>
  <figcaption class="meta">{still.caption[lang]}</figcaption>
</figure>

<style>
  .still {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  /* 地灯打在卡片下面 */
  .stage {
    position: relative;
    width: 100%;
    display: grid;
    place-items: center;
    padding: clamp(56px, 10svh, 112px) 0;
    background: radial-gradient(ellipse 40% 60% at 50% 100%, color-mix(in oklab, var(--accent) 18%, transparent), transparent 70%);
  }

  /* 地灯收成卡片脚下的一团，四周都淡出去，不留舞台边 */
  .still--compact .stage {
    padding: clamp(20px, 4svh, 44px) 0 clamp(36px, 7svh, 72px);
    background: radial-gradient(ellipse 36% 38% at 50% 72%, color-mix(in oklab, var(--accent) 24%, transparent), transparent 70%);
  }

  .still--compact figcaption {
    display: none;
  }

  .sheet {
    width: min(360px, 86vw);
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: var(--font-sans);
    color: var(--ink);
  }

  .items {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* App 的卡片：平整的表面色，顶上一层很淡的受光，描边上亮下暗 */
  .card {
    position: relative;
    border-radius: 22px;
    border: 1px solid var(--line);
    border-top-color: color-mix(in srgb, var(--ink) 20%, transparent);
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--accent) 5%, transparent), transparent 50%),
      var(--bg-raise);
    box-shadow: 0 28px 56px -24px rgb(0 0 0 / 0.65);
  }

  .items .card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 12px 16px 12px 12px;
  }

  /* 图标块：强调色淡淡铺底，线描用强调色 */
  .icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .icon svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon :global(.fill) {
    fill: var(--accent);
    stroke: none;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .name {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .sub {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--ink-3);
    white-space: nowrap;
  }

  /* 状态：使用中是实心强调色，已退役是实心淡墨，已售出只剩一圈 */
  .dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .dot--in-use {
    background: var(--accent);
  }

  .dot--retired {
    background: var(--ink-3);
  }

  .dot--sold {
    box-shadow: inset 0 0 0 1px var(--ink-3);
  }

  .nums {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  /* 数字是主角：衬线、等宽数字 */
  .price {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-variant-numeric: tabular-nums;
  }

  .daily {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }

  .unit {
    color: var(--ink-3);
  }

  .total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 18px;
  }

  /* 眉题：小号、加宽字距、次要色 */
  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }

  .sum {
    font-family: var(--font-display);
    font-size: 1.875rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /* 不跟滚动时：卡片依次落下 → 每天花多少逐个出现 → 合计浮上来 */
  :global(.js) .card {
    opacity: 0;
    transform: translateY(12px);
  }

  :global(.js) .daily {
    opacity: 0;
  }

  :global(.js) .is-in .card {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s var(--ease-film),
      transform 0.8s var(--ease-film);
    transition-delay: calc(0.2s + var(--r, 0) * 0.18s);
  }

  :global(.js) .is-in .daily {
    opacity: 1;
    transition: opacity 0.6s ease calc(1.1s + var(--r, 0) * 0.15s);
  }

  :global(.js) .is-in .total {
    transition-delay: 1.7s;
  }
</style>
