---
/**
 * Yado 签名，三笔描边。
 * draw=true：页面加载后一笔一笔写出来；draw="inview"：滚动到眼前时再写。纯 CSS 驱动。
 * 书写动画照搬 yadoI 启动动画（yadoI/BrandAssets/yadoI.json）前半段只有 logo 的部分：
 * 同样的笔顺、时长和缓动，Lottie 的 trim path 换成 stroke-dashoffset。
 */
interface Props {
  draw?: boolean | 'inview';
  class?: string;
  label?: string;
}

const { draw = false, class: className, label = 'Yado' } = Astro.props;

/**
 * 笔顺（Lottie 60fps 的帧换成秒）：
 * 长笔（y 的尾 → a → d 的竖）0–1s，先慢后快再收住；
 * y 的左臂 0.92–1.42s，越写越快，像甩出去；
 * 最后一笔（进环、绕环、出锋）1.5–2s，起笔快、收笔慢。全程 2s。
 */
const strokes = [
  {
    d: 'M12.925 301.968C12.925 301.968 77.521 106.968 124.726 106.968C171.931 106.968 157.024 226.968 204.229 226.968C251.434 226.968 308.577 1.968 308.577 1.968',
    delay: 0,
    dur: 1,
    ease: 'cubic-bezier(0.55, 0.06, 0.36, 1)',
  },
  {
    d: 'M7.956 101.968C7.956 101.968 17.894 196.968 57.646 199.468C97.398 201.968 147.087 164.468 147.087 164.468',
    delay: 0.917,
    dur: 0.5,
    ease: 'cubic-bezier(0.55, 0.06, 1, 1)',
  },
  {
    d: 'M171.931 149.468C171.931 149.468 243.981 111.968 278.764 111.968C311.062 111.968 335.906 119.468 363.236 134.468C389.141 148.687 388.893 184.339 373.174 209.468C357.972 233.769 332.436 240.505 306.093 229.468C265.627 212.514 322.687 160.889 355.782 131.968C373.5 116.485 407.956 101.968 407.956 101.968',
    delay: 1.5,
    dur: 0.5,
    ease: 'cubic-bezier(0, 0, 0.36, 1)',
  },
];
---

<svg
  class:list={[
    'signature',
    { 'signature--draw': draw === true, 'signature--inview': draw === 'inview' },
    className,
  ]}
  viewBox="0 0 412 305"
  fill="none"
  role="img"
  aria-label={label}
  data-inview={draw === 'inview' ? '' : undefined}
>
  {strokes.map((s) => <path d={s.d} pathLength="1" style={`--d:${s.delay}s;--t:${s.dur}s;--e:${s.ease}`} />)}
</svg>

<style>
  .signature {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  path {
    stroke: currentColor;
    stroke-width: 16;
  }

  /*
   * 没开始写之前整笔藏在空隙里。空隙（2）比整笔（1）长，偏移 1.5 让整笔落在空隙正中，
   * 两头各留 0.5 余量；如果空隙刚好等于笔长、偏移又多一点，下一段虚线会从笔尾露出来，
   * 16 粗的平头笔画会在每笔末端留下一道小白线。
   */
  .signature--draw path,
  :global(.js) .signature--inview path {
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1.5;
  }

  .signature--draw path,
  :global(.js) .signature--inview.is-in path {
    animation: write calc(var(--t) * var(--sig-scale, 1)) var(--e)
      calc(var(--sig-start, 0s) + var(--d) * var(--sig-scale, 1)) forwards;
  }

  /* 从 1 开始（笔头刚好在空隙起点），不然前一小段时间什么都不画 */
  @keyframes write {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
