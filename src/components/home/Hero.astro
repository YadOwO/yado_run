---
/**
 * 序「主张」：宽银幕标题卡里的一句话，说的是这个人，不是某个产品。
 * 入场跟着片头走（--intro-delay），不依赖滚动。
 */
import TitleCard from '@/components/TitleCard.astro';
import { strings, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang];
---

<TitleCard scene="01" label={t.scenes.manifesto} cue={{ href: '#chapters', label: t.hero.scroll }}>
  <h1 class="display title">
    {
      t.hero.lines.map((line, i) => (
        <span class="mask-line">
          <span style={`--i:${i}`} set:html={line} />
        </span>
      ))
    }
  </h1>
  <p class="lede">{t.hero.lede}</p>
</TitleCard>

<style>
  .title {
    grid-column: 1 / span 10;
    font-size: var(--fs-hero);
  }

  .title :global(.mask-line > span) {
    animation: line-rise var(--dur-reveal) var(--ease-film) calc(var(--intro-delay) + var(--i) * 140ms) both;
  }

  .lede {
    grid-column: 8 / span 5;
    animation: enter-up 1.6s var(--ease-film) calc(var(--intro-delay) + 0.7s) both;
  }

  @media (max-width: 900px) {
    .title {
      grid-column: 1 / -1;
    }

    .lede {
      grid-column: 1 / span 10;
    }
  }

  @media (max-width: 640px) {
    .lede {
      grid-column: 1 / -1;
    }
  }
</style>
