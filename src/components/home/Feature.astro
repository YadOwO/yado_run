---
/**
 * 第二幕「即将上映」：首页唯一有颜色的一幕，颜色来自当前主推产品。
 * 整块画幅可点，点击后画幅放大成产品页首屏（共享 view-transition-name）。
 */
import KeyArt from '@/components/KeyArt.astro';
import StatusChip from '@/components/StatusChip.astro';
import type { Product } from '@/data/products';
import { href, strings, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
  product: Product;
}

const { lang, product } = Astro.props;
const t = strings[lang];
const other: Lang = lang === 'en' ? 'zh' : 'en';
const link = product.page ? href(lang, `/${product.slug}/`) : undefined;
---

<section
  class="feature"
  id="coming-soon"
  data-scene="02"
  data-scene-label={t.status[product.status]}
  data-scene-accent={product.accent}
  style={`--accent: ${product.accent}`}
>
  <div class="spill" aria-hidden="true"></div>

  <header class="head" data-reveal>
    <StatusChip status={product.status} lang={lang} />
  </header>

  {
    link ? (
      <a class="art" href={link} aria-label={`${product.name[lang]} — ${t.feature.enter}`} data-reveal style="--i:1">
        <KeyArt product={product} variant="panel" />
      </a>
    ) : (
      <div class="art" data-reveal style="--i:1">
        <KeyArt product={product} variant="panel" />
      </div>
    )
  }

  <div class="info">
    <div class="titles" data-reveal-lines>
      <h2 class="display name">
        <span class="mask-line"><span>{product.name[lang]}</span></span>
      </h2>
      <p class="meta case original" data-reveal style="--i:2">
        {product.name[other]} · {product.platform} · {product.year}
      </p>
    </div>

    <div class="desc">
      {product.logline && <p class="logline" data-reveal style="--i:2">{product.logline[lang]}</p>}
      {
        link && (
          <a class="link meta enter" href={link} data-reveal style="--i:3">
            {t.feature.enter}
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .feature {
    position: relative;
    overflow-x: clip;
    padding: clamp(96px, 16svh, 180px) var(--gutter) clamp(96px, 14svh, 160px);
  }

  /* 产品色的余光，轻轻漫到黑场里 */
  .spill {
    position: absolute;
    inset: 10% -10% 0;
    z-index: -1;
    background: radial-gradient(ellipse 50% 40% at 50% 55%, color-mix(in oklab, var(--accent) 10%, transparent), transparent 70%);
    pointer-events: none;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20px;
  }

  .art {
    display: block;
  }

  a.art {
    cursor: pointer;
  }

  .info {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gutter);
    row-gap: 32px;
    margin-top: clamp(32px, 5svh, 56px);
  }

  .titles {
    grid-column: 1 / span 7;
  }

  .name {
    font-size: var(--fs-title);
  }

  .original {
    margin-top: 18px;
  }

  .desc {
    grid-column: 8 / span 5;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    padding-top: 0.6em;
  }

  .logline {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2vw, 1.875rem);
    line-height: 1.3;
    color: var(--ink);
  }

  :lang(zh) .logline {
    font-weight: 500;
    line-height: 1.6;
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
  }

  .enter {
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .titles,
    .desc {
      grid-column: 1 / -1;
    }
  }
</style>
