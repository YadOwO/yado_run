---
/**
 * HUD 右上角的「目录」：全屏的章节选择。
 * 用原生 Popover API（popovertarget），开关、Esc 关闭、焦点都由浏览器处理，不需要脚本；
 * 进出场用 @starting-style，不支持的浏览器直接出现。
 */
import { CHAPTERS, RESERVE_NEXT_CHAPTER, chapterNo, chapterPath } from '@/data/chapters';
import { contact, href, strings, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
  /** 当前页不带语言前缀的路径，用来标出「你在这里」 */
  path: string;
}

const { lang, path } = Astro.props;
const t = strings[lang];

const items = [
  { no: '00', title: t.hud.prologue, path: '/', current: path === '/' },
  ...CHAPTERS.map((c) => ({
    no: chapterNo(c.slug),
    title: c.title[lang],
    path: chapterPath(c),
    current: path.startsWith(chapterPath(c)),
  })),
];
const reservedNo = String(CHAPTERS.length + 1).padStart(2, '0');
---

<div class="index" id="hud-index" popover aria-label={t.hud.index}>
  <div class="bar bar--top" aria-hidden="true"></div>
  <div class="bar bar--bottom" aria-hidden="true"></div>

  <p class="meta corner corner--tl" aria-hidden="true">{t.hud.index}</p>
  <button class="meta corner corner--tr close" type="button" popovertarget="hud-index" popovertargetaction="hide">
    {t.hud.close}
    <i aria-hidden="true"></i>
  </button>

  <nav class="list" aria-label={t.hud.index}>
    <ol>
      {
        items.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={href(lang, item.path)} aria-current={item.current ? 'page' : undefined}>
              <span class="meta no">{item.no}</span>
              <span class="display title">{item.title}</span>
            </a>
          </li>
        ))
      }
      {
        RESERVE_NEXT_CHAPTER && (
          <li class="reserved" style={`--i:${items.length}`}>
            <span class="meta no">{reservedNo}</span>
            <span class="display title">{t.chapters.reservedTitle}</span>
            <span class="meta tag">{t.chapters.reserved}</span>
          </li>
        )
      }
    </ol>
  </nav>

  <div class="foot">
    <a class="meta case link" href={`mailto:${contact.email}`}>{contact.email}</a>
    <nav class="meta lang" aria-label={t.hud.language}>
      <a href={href('en', path)} hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
      <span aria-hidden="true">/</span>
      <a href={href('zh', path)} hreflang="zh-CN" aria-current={lang === 'zh' ? 'true' : undefined}>中</a>
    </nav>
  </div>
</div>

<style>
  /* 覆盖浏览器给 popover 的默认样式，铺满整屏 */
  .index {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    color: var(--ink);
    /* 实底：目录是一个独立的「选章画面」，不透出后面的页面 */
    background: var(--bg);
    opacity: 0;
    transition:
      opacity 0.5s var(--ease-film),
      overlay 0.5s allow-discrete,
      display 0.5s allow-discrete;
  }

  .index:popover-open {
    display: grid;
    opacity: 1;
  }

  @starting-style {
    .index:popover-open {
      opacity: 0;
    }
  }

  .index::backdrop {
    background: transparent;
  }

  /* 遮幅从上下合拢进来 */
  .bar {
    position: absolute;
    left: 0;
    right: 0;
    height: var(--lb);
    background: var(--bg-deep);
    transform: scaleY(0);
    transition: transform 0.7s var(--ease-film);
  }

  .bar--top {
    top: 0;
    transform-origin: top;
  }

  .bar--bottom {
    bottom: 0;
    transform-origin: bottom;
  }

  .index:popover-open .bar {
    transform: none;
  }

  @starting-style {
    .index:popover-open .bar {
      transform: scaleY(0);
    }
  }

  .corner {
    position: absolute;
    top: var(--hud-inset);
    padding: 8px 0;
    z-index: 1;
  }

  .corner--tl {
    left: var(--hud-inset);
    color: var(--ink-3);
  }

  .corner--tr {
    right: var(--hud-inset);
  }

  .close {
    display: flex;
    align-items: center;
    gap: 0.9em;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  /* 一个细细的 × */
  .close i {
    position: relative;
    width: 12px;
    height: 12px;
  }

  .close i::before,
  .close i::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: currentColor;
    transform: rotate(45deg);
  }

  .close i::after {
    transform: rotate(-45deg);
  }

  .list {
    align-self: center;
    max-height: calc(100% - var(--lb) * 2);
    overflow-y: auto;
    scrollbar-width: none;
    padding: 0 var(--gutter);
  }

  .list ol {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .list li {
    border-bottom: 1px solid var(--line);
    opacity: 1;
    transform: none;
    transition:
      opacity 0.9s var(--ease-film) calc(0.12s + var(--i) * 60ms),
      transform 0.9s var(--ease-film) calc(0.12s + var(--i) * 60ms);
  }

  @starting-style {
    .index:popover-open .list li {
      opacity: 0;
      transform: translate3d(0, 24px, 0);
    }
  }

  .list a,
  .reserved {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    align-items: baseline;
    gap: 16px;
    padding: clamp(12px, 2.2svh, 22px) 0;
  }

  .title {
    font-size: clamp(2rem, 5vw, 4.25rem);
    line-height: 1.05;
    transition:
      transform 0.9s var(--ease-film),
      color 0.6s var(--ease-film);
  }

  .list a .title {
    color: var(--ink-2);
  }

  .list a:hover .title,
  .list a[aria-current] .title {
    color: var(--ink);
  }

  @media (hover: hover) {
    .list a:hover .title {
      transform: translateX(12px);
    }
  }

  /* 当前所在的章：编号左边一个小圆点（挂在边距里，不挤动编号） */
  .no {
    position: relative;
  }

  .list a[aria-current] .no::before {
    content: '';
    position: absolute;
    left: -14px;
    top: 50%;
    width: 5px;
    height: 5px;
    margin-top: -2.5px;
    border-radius: 50%;
    background: var(--ink);
  }

  .reserved {
    color: var(--ink-4);
  }

  .reserved .title {
    color: var(--ink-4);
  }

  .tag {
    color: var(--ink-4);
  }

  .foot {
    position: absolute;
    left: var(--hud-inset);
    right: var(--hud-inset);
    bottom: var(--hud-inset);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    z-index: 1;
  }

  .foot .link {
    color: var(--ink-2);
  }

  .lang {
    display: flex;
    gap: 0.7em;
    color: var(--ink-4);
  }

  .lang a {
    color: var(--ink-3);
  }

  .lang a[aria-current] {
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .list a,
    .reserved {
      grid-template-columns: 2.75rem 1fr;
    }

    .tag {
      display: none;
    }
  }
</style>
