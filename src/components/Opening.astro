---
/**
 * 片头：黑场 → 签名一笔一笔写出 → 出品字幕 → 上下两块黑幕退到遮幅位置，露出第一幕。
 * 全程纯 CSS，每个会话只放一次；点击、按键、滚轮都能跳过（逻辑在 scripts/stage.ts）。
 * 时间线：签名 0.3–2.3s（和 yadoI 启动动画同速），字幕 2.0s 起，标题淡出 3.0s，开幕 3.1–4.6s。
 */
import Signature from './Signature.astro';
import { strings, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const t = strings[Astro.props.lang];
---

<div class="opening" data-opening-overlay aria-hidden="true">
  <div class="bar bar--top"></div>
  <div class="bar bar--bottom"></div>
  <div class="title">
    <Signature draw class="sig" />
    <p class="meta credit">{t.opening.credit}</p>
  </div>
  <p class="meta skip">{t.opening.skip}</p>
</div>

<style>
  .opening {
    position: fixed;
    inset: 0;
    z-index: 100;
    cursor: pointer;
    animation: opening-done 0s linear 4.6s forwards;
  }

  :global(:root[data-opening='skip']) .opening:not(.is-leaving) {
    display: none;
  }

  /* 中途跳过：整体淡出 */
  .opening.is-leaving {
    pointer-events: none;
    animation: leave 0.6s var(--ease-pen) forwards;
  }

  @keyframes leave {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  @keyframes opening-done {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }

  /* 两块黑幕各占半屏，开幕时只位移（transform），停在遮幅高度 --lb */
  .bar {
    position: absolute;
    left: 0;
    right: 0;
    height: 50.5svh;
    background: var(--bg-deep);
    will-change: transform;
  }

  .bar--top {
    top: 0;
    animation: open-top 1.5s var(--ease-film) 3.1s forwards;
  }

  .bar--bottom {
    bottom: 0;
    animation: open-bottom 1.5s var(--ease-film) 3.1s forwards;
  }

  @keyframes open-top {
    to {
      transform: translate3d(0, calc(var(--lb) - 50.5svh), 0);
    }
  }

  @keyframes open-bottom {
    to {
      transform: translate3d(0, calc(50.5svh - var(--lb)), 0);
    }
  }

  .title {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(28px, 4svh, 44px);
    animation: title-out 0.5s var(--ease-pen) 3s forwards;
  }

  @keyframes title-out {
    to {
      opacity: 0;
      transform: scale(0.985);
    }
  }

  .title :global(.sig) {
    width: clamp(132px, 15vw, 210px);
    color: var(--ink);
    --sig-start: 0.3s;
  }

  .credit {
    color: var(--ink-2);
    letter-spacing: 0.42em;
    opacity: 0;
    animation: credit-in 1.1s var(--ease-film) 2s forwards;
  }

  @keyframes credit-in {
    to {
      opacity: 1;
      letter-spacing: 0.3em;
    }
  }

  .skip {
    position: absolute;
    left: 50%;
    bottom: var(--hud-inset);
    translate: -50% 0;
    color: var(--ink-4);
    letter-spacing: 0.2em;
    opacity: 0;
    animation:
      skip-in 0.8s ease 1.2s forwards,
      title-out 0.4s ease 3s forwards;
  }

  @keyframes skip-in {
    to {
      opacity: 1;
    }
  }
</style>
