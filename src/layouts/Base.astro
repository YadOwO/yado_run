---
/**
 * 全站母版：head、片框（HUD、颗粒、暗角）和唯一的客户端脚本。
 * 字体全部自托管；中文衬线只在中文页面引入（见 pages/zh）。
 */
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/geist-mono/latin-400.css';
import '@/styles/global.css';
import serifWoff2 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import monoWoff2 from '@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url';

import Hud from '@/components/Hud.astro';
import Opening from '@/components/Opening.astro';
import type { ProductTheme } from '@/data/products';
import { href, htmlLang, strings, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
  /** 不带语言前缀的路径，例如 `/` 或 `/yadoa/` */
  path: string;
  title?: string;
  description?: string;
  /** 是否播放片头（只有首页） */
  opening?: boolean;
  /** 首屏场景标签，例如 `01 — Manifesto` */
  firstScene: string;
  /** 时间码换算用的“片长”（秒），整页滚完等于放完 */
  runtime?: number;
  /** 产品自己的世界：整页换成产品 App 深色外观的底色和墨色（见 tokens.css 的 data-theme='app'） */
  theme?: ProductTheme;
}

const { lang, path, opening = false, firstScene, runtime = 90, theme } = Astro.props;
const t = strings[lang];
const title = Astro.props.title ?? t.site.title;
const description = Astro.props.description ?? t.site.description;
const site = Astro.site ?? new URL('https://my.yado1225.top');
const canonical = new URL(href(lang, path), site).href;
const ogImage = new URL('/og-image.png', site).href;
const themeStyle = theme
  ? `--bg:${theme.paper};--bg-raise:${theme.surface};--ink:${theme.ink}`
  : undefined;
---

<!doctype html>
<html lang={htmlLang[lang]} class="no-js" data-theme={theme ? 'app' : undefined} style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={theme?.paper ?? '#0a0a0b'} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Yado" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', path), site).href} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(href('zh', path), site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(href('en', path), site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    {/* 产品主题的标题用系统衬线，不需要预载 Instrument Serif */}
    {!theme && <link rel="preload" href={serifWoff2} as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href={monoWoff2} as="font" type="font/woff2" crossorigin />

    <!-- 在首帧之前决定两件事：片头放不放（每个会话一次；带锚点、减少动态效果、非首页都跳过），返回按钮显不显示 -->
    <script is:inline define:vars={{ opening }}>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        d.classList.add('js');
        var skip = !opening || !!location.hash;
        try {
          var key = 'yado_run:opening';
          if (sessionStorage.getItem(key)) skip = true;
          sessionStorage.setItem(key, '1');
        } catch (e) {}
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) skip = true;
        if (skip) d.dataset.opening = 'skip';

        // 返回按钮：这个标签页里，前面有本站的另一个页面才显示（直接打开的页面没有可回的地方）。
        // 同一页的另一种语言、同一页的锚点不算「上一页」，跳过去找再前面的；要回到的那一条记在 <html> 上。
        try {
          var page = function (u) {
            return new URL(u, location.href).pathname.replace(/^\/zh(?=\/|$)/, '').replace(/\/+$/, '');
          };
          var here = page(location.href);
          var nav = window.navigation;
          if (nav && nav.currentEntry) {
            // navigation.entries() 只有这个标签页里连续的同源记录
            var list = nav.entries();
            for (var i = nav.currentEntry.index - 1; i >= 0; i--) {
              if (list[i].url && page(list[i].url) !== here) {
                d.dataset.back = list[i].key;
                break;
              }
            }
          } else if (document.referrer && new URL(document.referrer).origin === location.origin && page(document.referrer) !== here) {
            d.dataset.back = '';
          }
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body data-runtime={runtime}>
    {opening && <Opening lang={lang} />}
    <Hud lang={lang} path={path} firstScene={firstScene} />

    <main>
      <slot />
    </main>
    <slot name="footer" />

    <div class="vignette" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <script>
      import '@/scripts/stage';
    </script>
  </body>
</html>
