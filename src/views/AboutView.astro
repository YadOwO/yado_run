---
/**
 * 人物章：标题卡（签名 + 人物介绍卡）→ 自述 → 做事的方式 → 屏幕之外 → 下一章 → 片尾。
 * 内容在 data/about.ts。
 */
import Base from '@/layouts/Base.astro';
import Credits from '@/components/Credits.astro';
import NextChapter from '@/components/NextChapter.astro';
import Signature from '@/components/Signature.astro';
import TitleCard from '@/components/TitleCard.astro';
import { offscreen, principles, profile } from '@/data/about';
import { chapterNo, getChapter } from '@/data/chapters';
import { contact, strings, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang];
const chapter = getChapter('about');
const label = chapter.title[lang];
const pad = (n: number) => String(n).padStart(2, '0');

/** 自述按词（中文按字）拆开，滚动时逐个点亮 */
const statement = profile.statement[lang];
const tokens = lang === 'zh' ? Array.from(statement) : statement.split(' ');
const joiner = lang === 'zh' ? '' : ' ';
---

<Base
  lang={lang}
  path="/about/"
  title={`${label} — ${t.site.title}`}
  description={chapter.logline[lang]}
  firstScene={`01 — ${label}`}
>
  <!-- 01 标题卡：签名当片名，旁边是一张人物介绍卡 -->
  <TitleCard scene="01" label={label} cue={{ href: '#statement', label: t.hero.scroll }}>
    <p class="meta kicker" data-enter>{t.chapters.chapter}{chapterNo('about')} — {label}</p>
    <h1 class="name">
      <Signature draw class="sig" />
    </h1>
    <dl class="card">
      <div class="card__row" data-enter style="--i:4">
        <dt class="meta">{t.about.labels.role}</dt>
        <dd>{profile.role[lang]}</dd>
      </div>
      <div class="card__row" data-enter style="--i:5">
        <dt class="meta">{t.about.labels.identity}</dt>
        <dd>{profile.identity[lang]}</dd>
      </div>
      <div class="card__row" data-enter style="--i:6">
        <dt class="meta">{t.about.labels.contact}</dt>
        <dd><a class="link" href={`mailto:${contact.email}`}>{contact.email}</a></dd>
      </div>
    </dl>
  </TitleCard>

  <!-- 02 自述：滚动到这里时，字一个一个亮起来 -->
  <section class="statement" id="statement" data-scene="02" data-scene-label={t.scenes.statement}>
    <p class="meta" data-reveal>{t.scenes.statement}</p>
    <p class="display words">
      {
        tokens.map((w, i) => (
          <Fragment>
            <span class="w" style={`--p:${(i / tokens.length).toFixed(3)}`}>{w}</span>
            {joiner}
          </Fragment>
        ))
      }
    </p>
  </section>

  <!-- 03 做事的方式 -->
  <section class="principles" data-scene="03" data-scene-label={t.scenes.principles}>
    <div class="intro">
      <h2 class="display heading" data-reveal-lines>
        <span class="mask-line"><span>{t.about.principles}</span></span>
      </h2>
    </div>
    <ol class="grid">
      {
        principles.map((p, i) => (
          <li class="principle" data-reveal style={`--i:${i % 2}`}>
            <span class="meta no">{pad(i + 1)}</span>
            <h3 class="display principle__title">{p.title[lang]}</h3>
            <p class="principle__body">{p.body[lang]}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 04 屏幕之外：三张剧照，每张一小段纯 CSS 动画 -->
  <section class="offscreen" data-scene="04" data-scene-label={t.scenes.offscreen}>
    <div class="intro">
      <h2 class="display heading" data-reveal-lines>
        <span class="mask-line"><span>{t.about.offscreen}</span></span>
      </h2>
    </div>
    <ol class="stills">
      {
        offscreen.map((o, i) => (
          <li class="still-item" data-reveal style={`--i:${i}`}>
            <figure class="still">
              <span class="meta case tag">
                {t.about.still} {pad(i + 1)} — {o.label[lang]}
              </span>
              <div class={`motif motif--${o.motif}`} aria-hidden="true">
                {o.motif === 'road' && (
                  <Fragment>
                    <i class="edge" />
                    <i class="dash" />
                  </Fragment>
                )}
                {o.motif === 'crosshair' && (
                  <Fragment>
                    <i class="arm arm--t" />
                    <i class="arm arm--r" />
                    <i class="arm arm--b" />
                    <i class="arm arm--l" />
                  </Fragment>
                )}
                {o.motif === 'eq' && Array.from({ length: 7 }, (_, k) => <i class="bar" style={`--k:${k}`} />)}
              </div>
              <figcaption>
                <span class="display still__title">{o.title[lang]}</span>
                <span class="meta case">{o.detail?.[lang] ?? '\u00a0'}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ol>
  </section>

  <NextChapter lang={lang} slug="about" scene="05" />
  <Credits lang={lang} scene="06" slot="footer" />
</Base>

<style>
  /* ---------- 01 标题卡 ---------- */
  .kicker {
    grid-column: 1 / -1;
  }

  .name {
    grid-column: 1 / span 6;
    color: var(--ink);
  }

  .name :global(.sig) {
    width: min(100%, calc((100svh - var(--lb) * 2 - 160px) * 1.35));
    --sig-start: 0.35s;
  }

  .card {
    grid-column: 8 / span 5;
    align-self: end;
    border-top: 1px solid var(--line);
  }

  .card__row {
    display: grid;
    grid-template-columns: 7.5em 1fr;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .card dd {
    color: var(--ink);
  }

  .card .link {
    padding-bottom: 2px;
  }

  /* ---------- 02 自述 ---------- */
  .statement {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gutter);
    row-gap: 36px;
    padding: clamp(96px, 16svh, 180px) var(--gutter);
  }

  .statement > .meta {
    grid-column: 1 / -1;
  }

  .words {
    grid-column: 1 / span 11;
    font-size: var(--fs-h2);
    line-height: 1.22;
    text-wrap: pretty;
    view-timeline: --statement block;
  }

  :lang(zh) .words {
    line-height: 1.7;
  }

  /* 支持滚动时间线的浏览器：整段经过画面中部时，字按顺序从暗到亮 */
  @supports (animation-timeline: view()) {
    .w {
      animation: lit linear both;
      animation-range: cover calc(16% + var(--p) * 34%) cover calc(21% + var(--p) * 34%);
    }

    /* animation-timeline 必须单独一条规则：CSS 压缩会把它并进 animation 简写，Chrome 不认，整条丢掉 */
    .words > .w {
      animation-timeline: --statement;
    }

    @keyframes lit {
      from {
        opacity: 0.16;
      }
      to {
        opacity: 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .w {
      animation: none;
    }
  }

  /* ---------- 03 做事的方式 ---------- */
  .principles,
  .offscreen {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gutter);
    row-gap: 48px;
    margin: 0 var(--gutter);
    padding: clamp(80px, 14svh, 160px) 0;
    border-top: 1px solid var(--line);
  }

  .intro {
    grid-column: 1 / span 4;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .heading {
    font-size: var(--fs-h2);
  }

  .grid {
    grid-column: 5 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
  }

  .principle {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 24px 0 40px;
    border-top: 1px solid var(--line);
  }

  .principle__title {
    font-size: clamp(1.375rem, 1.9vw, 1.75rem);
    line-height: 1.15;
  }

  :lang(zh) .principle__title {
    font-size: clamp(1.1875rem, 1.5vw, 1.375rem);
  }

  .principle__body {
    color: var(--ink-2);
    max-width: 32em;
  }

  /* ---------- 04 屏幕之外 ---------- */
  .stills {
    grid-column: 5 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 1.6vw, 24px);
  }

  .still {
    position: relative;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--line);
    background:
      radial-gradient(ellipse 70% 50% at 50% 0%, rgb(236 232 225 / 0.06), transparent 70%),
      #0d0c0c;
  }

  .tag {
    position: absolute;
    top: 18px;
    left: 18px;
  }

  figcaption {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    display: grid;
    gap: 8px;
  }

  .still__title {
    font-size: clamp(1.5rem, 2.2vw, 2.125rem);
    line-height: 1.05;
  }

  .motif {
    position: relative;
    width: 56%;
    height: 72px;
    translate: 0 -12px;
    color: var(--ink-2);
  }

  .motif i {
    position: absolute;
    display: block;
  }

  /* 公路：路沿不动，中线向后退，像在往前骑 */
  .motif--road {
    overflow: hidden;
  }

  .edge {
    left: 0;
    right: 0;
    top: 22px;
    height: 1px;
    background: var(--ink-4);
  }

  .dash {
    left: 0;
    top: 48px;
    width: calc(100% + 36px);
    height: 1px;
    background: repeating-linear-gradient(90deg, currentColor 0 18px, transparent 18px 36px);
    animation: ride 0.9s linear infinite;
  }

  @keyframes ride {
    to {
      transform: translateX(-36px);
    }
  }

  /* 准星：每隔一会儿开一枪，四根线向外弹开再收回 */
  .arm {
    left: 50%;
    top: 50%;
    background: currentColor;
    animation: recoil 2.6s var(--ease-film) infinite;
  }

  .arm--t,
  .arm--b {
    width: 1px;
    height: 14px;
    margin-left: -0.5px;
  }

  .arm--l,
  .arm--r {
    width: 14px;
    height: 1px;
    margin-top: -0.5px;
  }

  /* translate 摆好位置（中心留 6px 空隙），--dx/--dy 是开枪时弹开的方向 */
  .arm--t { translate: 0 calc(-100% - 6px); --dx: 0px; --dy: -7px; }
  .arm--b { translate: 0 6px; --dx: 0px; --dy: 7px; }
  .arm--l { translate: calc(-100% - 6px) 0; --dx: -7px; --dy: 0px; }
  .arm--r { translate: 6px 0; --dx: 7px; --dy: 0px; }

  @keyframes recoil {
    0%,
    78%,
    100% {
      transform: none;
    }
    82% {
      transform: translate(var(--dx), var(--dy));
    }
  }

  /* 均衡器：七根柱子各按自己的节拍起落 */
  .motif--eq {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 7px;
  }

  .motif--eq .bar {
    position: relative;
    width: 3px;
    height: 100%;
    background: currentColor;
    transform-origin: bottom;
    animation: eq calc(0.7s + var(--k) * 0.13s) ease-in-out calc(var(--k) * -0.37s) infinite alternate;
  }

  @keyframes eq {
    from {
      transform: scaleY(0.12);
    }
    to {
      transform: scaleY(1);
    }
  }

  /* ---------- 窄屏 ---------- */
  @media (max-width: 900px) {
    .name,
    .card,
    .words,
    .intro,
    .grid,
    .stills {
      grid-column: 1 / -1;
    }

    .name {
      max-width: 420px;
    }
  }

  @media (max-width: 640px) {
    .card__row {
      grid-template-columns: 5.5em 1fr;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .principles,
    .offscreen {
      margin: 0;
      padding-left: var(--gutter);
      padding-right: var(--gutter);
    }

    /* 剧照横向滑动，和片单一致 */
    .stills {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-right: calc(var(--gutter) * -1);
      padding-right: var(--gutter);
    }

    .stills::-webkit-scrollbar {
      display: none;
    }

    .still-item {
      flex: 0 0 68vw;
      scroll-snap-align: start;
    }
  }
</style>
