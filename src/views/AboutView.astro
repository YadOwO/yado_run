---
/**
 * 人物章：标题卡（签名 + 人物介绍卡）→ 自述 → 幕后 → 下班后 → 下一章 → 片尾。
 * 内容在 data/about.ts。
 */
import Base from '@/layouts/Base.astro';
import Credits from '@/components/Credits.astro';
import NextChapter from '@/components/NextChapter.astro';
import Signature from '@/components/Signature.astro';
import TitleCard from '@/components/TitleCard.astro';
import { behind, hobbies, profile } from '@/data/about';
import { chapterNo, chapterPath, getChapter } from '@/data/chapters';
import { contact, href, strings, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang];
const chapter = getChapter('about');
const label = chapter.title[lang];
const worksHref = href(lang, chapterPath(getChapter('works')));
const pad = (n: number) => String(n).padStart(2, '0');

/** 自述按词（中文按字）拆开，滚动时逐个点亮 */
const statement = profile.statement[lang];
const tokens = lang === 'zh' ? Array.from(statement) : statement.split(' ');
const joiner = lang === 'zh' ? '' : ' ';
---

<Base
  lang={lang}
  path="/about/"
  title={`${label} — ${t.site.title}`}
  description={chapter.logline[lang]}
  firstScene={`01 — ${label}`}
>
  <!-- 01 标题卡：签名当片名，旁边是一张人物介绍卡 -->
  <TitleCard scene="01" label={label} cue={{ href: '#statement', label: t.hero.scroll }}>
    <p class="meta kicker" data-enter>{t.chapters.chapter}{chapterNo('about')} — {label}</p>
    <h1 class="name">
      <Signature draw class="sig" />
    </h1>
    <dl class="card">
      <div class="card__row" data-enter style="--i:4">
        <dt class="meta">{t.about.labels.identity}</dt>
        <dd>{profile.identity[lang]}</dd>
      </div>
      <div class="card__row" data-enter style="--i:5">
        <dt class="meta">{t.about.labels.job}</dt>
        <dd>{profile.job[lang]}</dd>
      </div>
      <div class="card__row" data-enter style="--i:6">
        <dt class="meta">{t.about.labels.making}</dt>
        <dd><a class="link" href={worksHref}>{profile.making[lang]}</a></dd>
      </div>
      <div class="card__row" data-enter style="--i:7">
        <dt class="meta">{t.about.labels.contact}</dt>
        <dd><a class="link" href={`mailto:${contact.email}`}>{contact.email}</a></dd>
      </div>
    </dl>
  </TitleCard>

  <!-- 02 自述：滚动到这里时，字一个一个亮起来 -->
  <section class="statement" id="statement" data-scene="02" data-scene-label={t.scenes.statement}>
    <p class="meta" data-reveal>{t.scenes.statement}</p>
    <p class="display words">
      {
        tokens.map((w, i) => (
          <Fragment>
            <span class="w" style={`--p:${(i / tokens.length).toFixed(3)}`}>{w}</span>
            {joiner}
          </Fragment>
        ))
      }
    </p>
  </section>

  <!-- 03 幕后：芽豆系列是怎么做出来的 -->
  <section class="behind" data-scene="03" data-scene-label={t.scenes.behind}>
    <div class="intro">
      <h2 class="display heading" data-reveal-lines>
        <span class="mask-line"><span>{t.about.behind}</span></span>
      </h2>
      <p class="intro__lede" data-reveal style="--i:1">{behind.lede[lang]}</p>
    </div>
    <ol class="rows">
      {
        behind.items.map((item, i) => (
          <li class="row" data-reveal>
            <span class="meta no">{pad(i + 1)}</span>
            <h3 class="display row__label">{item.label[lang]}</h3>
            <p class="row__body">{item.body[lang]}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 04 下班后：一排剧照，几张都排得下（多了横向滑动） -->
  <section class="after" data-scene="04" data-scene-label={t.scenes.after}>
    <div class="intro">
      <h2 class="display heading" data-reveal-lines>
        <span class="mask-line"><span>{t.about.after}</span></span>
      </h2>
    </div>
    <ol class="stills">
      {
        hobbies.map((h, i) => {
          const Mark = h.mark;
          return (
            <li class="still-item" data-reveal style={`--i:${Math.min(i, 4)}`}>
              <figure class="still">
                <span class="meta case tag">
                  {t.about.still} {pad(i + 1)}
                </span>
                <div class="stage" aria-hidden="true">
                  {Mark ? <Mark /> : <span class="display fallback">{h.title[lang]}</span>}
                  <i class="floor" />
                </div>
                <figcaption>
                  <span class="display still__title">{h.title[lang]}</span>
                  <span class="still__detail">{h.detail?.[lang] ?? '\u00a0'}</span>
                </figcaption>
              </figure>
            </li>
          );
        })
      }
    </ol>
  </section>

  <NextChapter lang={lang} slug="about" scene="05" />
  <Credits lang={lang} scene="06" slot="footer" />
</Base>

<style>
  /* ---------- 01 标题卡 ---------- */
  .kicker {
    grid-column: 1 / -1;
  }

  .name {
    grid-column: 1 / span 6;
    color: var(--ink);
  }

  .name :global(.sig) {
    width: min(100%, calc((100svh - var(--lb) * 2 - 160px) * 1.35));
    --sig-start: 0.35s;
  }

  .card {
    grid-column: 8 / span 5;
    align-self: end;
    border-top: 1px solid var(--line);
  }

  .card__row {
    display: grid;
    grid-template-columns: 7.5em 1fr;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .card dd {
    color: var(--ink);
  }

  .card .link {
    padding-bottom: 2px;
  }

  /* ---------- 02 自述 ---------- */
  .statement {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gutter);
    row-gap: 36px;
    padding: clamp(96px, 16svh, 180px) var(--gutter);
  }

  .statement > .meta {
    grid-column: 1 / -1;
  }

  .words {
    grid-column: 1 / span 11;
    font-size: var(--fs-h2);
    line-height: 1.22;
    text-wrap: pretty;
    view-timeline: --statement block;
  }

  :lang(zh) .words {
    line-height: 1.7;
  }

  /* 支持滚动时间线的浏览器：整段经过画面中部时，字按顺序从暗到亮 */
  @supports (animation-timeline: view()) {
    .w {
      animation: lit linear both;
      animation-range: cover calc(16% + var(--p) * 34%) cover calc(21% + var(--p) * 34%);
    }

    /* animation-timeline 必须单独一条规则：CSS 压缩会把它并进 animation 简写，Chrome 不认，整条丢掉 */
    .words > .w {
      animation-timeline: --statement;
    }

    @keyframes lit {
      from {
        opacity: 0.16;
      }
      to {
        opacity: 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .w {
      animation: none;
    }
  }

  /* ---------- 03 幕后 / 04 下班后：共用的段落框架 ---------- */
  .behind,
  .after {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gutter);
    row-gap: 48px;
    margin: 0 var(--gutter);
    padding: clamp(80px, 14svh, 160px) 0;
    border-top: 1px solid var(--line);
  }

  .intro {
    grid-column: 1 / span 4;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .heading {
    font-size: var(--fs-h2);
  }

  .intro__lede {
    max-width: 26em;
    color: var(--ink-2);
    line-height: 1.7;
  }

  /* ---------- 03 幕后：一行一件事 ---------- */
  .rows {
    grid-column: 6 / -1;
    border-bottom: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 3rem minmax(6rem, 0.32fr) 1fr;
    align-items: baseline;
    gap: 16px;
    padding: clamp(20px, 3svh, 28px) 0;
    border-top: 1px solid var(--line);
  }

  .no {
    color: var(--ink-4);
  }

  .row__label {
    font-size: clamp(1.375rem, 1.9vw, 1.75rem);
    line-height: 1.15;
  }

  :lang(zh) .row__label {
    font-size: clamp(1.1875rem, 1.5vw, 1.375rem);
  }

  .row__body {
    color: var(--ink-2);
    max-width: 34em;
  }

  /* ---------- 04 下班后：一排剧照 ---------- */
  .after .intro {
    grid-column: 1 / -1;
  }

  /* 每张至少 220px、至多 360px；放不下就横向滑动，所以兴趣增减不用改样式 */
  .stills {
    grid-column: 1 / -1;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(220px, 360px);
    gap: clamp(14px, 1.6vw, 24px);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* 剧照入场时从下方 28px 升上来；滚动容器会裁掉越界部分，留出这段距离 */
    padding-bottom: 32px;
    margin-bottom: -32px;
  }

  .stills::-webkit-scrollbar {
    display: none;
  }

  .still-item {
    scroll-snap-align: start;
  }

  .still {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--line);
    background:
      radial-gradient(ellipse 70% 46% at 50% 0%, rgb(236 232 225 / 0.07), transparent 70%),
      radial-gradient(ellipse 60% 40% at 50% 100%, rgb(236 232 225 / 0.04), transparent 70%),
      #0d0c0c;
  }

  .tag {
    position: absolute;
    top: 18px;
    left: 18px;
    z-index: 1;
  }

  /* 画面：标志放在偏上的位置，下面留给字幕 */
  .stage {
    position: absolute;
    inset: 0 0 26%;
    display: grid;
    place-items: center;
    color: var(--ink);
  }

  .stage :global(svg) {
    width: 34%;
    height: auto;
    fill: currentColor;
    filter: drop-shadow(0 18px 32px rgb(0 0 0 / 0.6));
    transition: transform 1.2s var(--ease-film);
  }

  .fallback {
    font-size: clamp(2rem, 3vw, 2.75rem);
    text-align: center;
    padding: 0 18px;
    transition: transform 1.2s var(--ease-film);
  }

  .floor {
    position: absolute;
    left: 50%;
    bottom: 16%;
    width: 40%;
    height: 6%;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.6), transparent);
    filter: blur(5px);
  }

  @media (hover: hover) {
    .still:hover .stage :global(svg),
    .still:hover .fallback {
      transform: translateY(-6px);
    }
  }

  figcaption {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    display: grid;
    gap: 8px;
  }

  .still__title {
    font-size: clamp(1.5rem, 2.2vw, 2.125rem);
    line-height: 1.05;
  }

  .still__detail {
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  /* ---------- 窄屏 ---------- */
  @media (max-width: 900px) {
    .name,
    .card,
    .words,
    .intro,
    .rows {
      grid-column: 1 / -1;
    }

    .name {
      max-width: 420px;
    }
  }

  @media (max-width: 640px) {
    .card__row {
      grid-template-columns: 5.5em 1fr;
    }

    .behind,
    .after {
      margin: 0;
      padding-left: var(--gutter);
      padding-right: var(--gutter);
    }

    /* 窄屏：编号一列，标签和说明上下排 */
    .row {
      grid-template-columns: 2.5rem 1fr;
      row-gap: 8px;
    }

    .row__body {
      grid-column: 2;
    }

    /* 剧照贴着右边缘滑出，和片单一致 */
    .stills {
      grid-auto-columns: 68vw;
      margin-right: calc(var(--gutter) * -1);
      padding-right: var(--gutter);
      scroll-padding-left: 0;
    }
  }
</style>
